{
    "name": "@hyaenidae/app",
    "version": "1.0.0",
    "private": true,
    "license": "GPL-3.0-only",
    "description": "An AI browser that can browse the web, use tools, and complete tasks with DOM-first automation and vision fallback.",
    "keywords": [
        "llm",
        "ai",
        "browser"
    ],
    "os": [
        "win32"
    ],
    "homepage": "https://github.com/mycrl/hyaenidae",
    "bugs": {
        "url": "https://github.com/mycrl/hyaenidae/issues",
        "email": "lepidodendraceae@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mycrl/hyaenidae.git"
    },
    "author": {
        "name": "mycrl",
        "email": "lepidodendraceae@gmail.com",
        "url": "https://github.com/mycrl"
    },
    "files": [
        "dist/**/*",
        "index.js"
    ],
    "main": "index.js",
    "scripts": {
        "start": "electron .",
        "build": "node build.js && tsc",
        "dev": "node build.js && tsc && electron .",
        "package": "electron-builder build --win --x64 --dir"
    },
    "dependencies": {
        "@huggingface/hub": "2.11.2",
        "@hyaenidae/bridge": "1.0.0",
        "@hyaenidae/mavis": "1.0.0",
        "pino": "10.3.1",
        "pino-pretty": "13.1.3"
    },
    "devDependencies": {
        "electron": "41.3.0",
        "electron-builder": "26.8.1",
        "esbuild": "0.28.0"
    },
    "build": {
        "copyright": "Copyright © 2026 ${author}",
        "appId": "com.hyaenidae.mycrl",
        "productName": "Hyaenidae",
        "removePackageKeywords": false,
        "icon": "assets/icon.ico",
        "files": [
            "./dist",
            "./index.js",
            "./package.json",
            "!./src",
            "!./build.js",
            "!**/{tsconfig.json,*.d.ts}",
            "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
            "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
            "!**/node_modules/*.d.ts",
            "!**/node_modules/.bin",
            "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
            "!.editorconfig",
            "!**/._*",
            "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
            "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
            "!**/{appveyor.yml,.travis.yml,circle.yml}",
            "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
        ],
        "extraFiles": [
            {
                "from": "../ui/dist",
                "to": "webview"
            }
        ],
        "directories": {
            "buildResources": "assets",
            "output": "out"
        }
    }
}
